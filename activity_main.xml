<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">

            <TextView android:text="ﷺ" android:textSize="56sp" android:textColor="@color/gold"
                android:fontFamily="serif" android:layout_marginTop="24dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/app_name" android:textSize="28sp" android:textColor="@color/cream"
                android:fontFamily="serif" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/hadith" android:textSize="13sp" android:textColor="@color/white_80"
                android:gravity="center" android:layout_marginTop="6dp" android:layout_marginBottom="28dp"
                android:layout_width="240dp" android:layout_height="wrap_content"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card" android:padding="22dp">

                <TextView android:id="@+id/counterText" android:text="صليت اليوم: 0 مرة"
                    android:textSize="20sp" android:textColor="@color/emerald" android:textStyle="bold"
                    android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/salatBtn" android:text="اللهم صل على محمد ﷺ"
                    android:textSize="16sp" app:cornerRadius="14dp"
                    android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="56dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#15000000" android:layout_marginTop="22dp" android:layout_marginBottom="16dp"/>

                <TextView android:text="⏰ مدة التذكير" android:textStyle="bold" android:textColor="@color/emerald"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp" android:weightSum="4">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn5" android:text="5د" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn15" android:text="15د" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn30" android:text="30د" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn60" android:text="60د" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="دقائق مخصصة">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/minutesInput" android:inputType="number" android:text="15" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/reminderSwitch"
                    android:text="تفعيل التذكير في الخلفية" android:textColor="@color/emerald"
                    android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <TextView android:text="🔊 الصوت المخصص" android:textStyle="bold" android:textColor="@color/emerald"
                    android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/uploadAudioBtn"
                    android:text="اختر ملف صوتي من جهازك" app:icon="@android:drawable/ic_btn_speak_now"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/recordBtn"
                    android:text="سجل صوتك الآن" app:icon="@android:drawable/ic_btn_speak_now"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <TextView android:id="@+id/audioPathText" android:text="لم يتم اختيار ملف - سيتم استخدام الصوت الافتراضي"
                    android:textSize="12sp" android:textColor="#8A000000"
                    android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

                <TextView android:text="ملاحظة: التطبيق يعمل حتى بعد إغلاقه وإعادة تشغيل الهاتف. يرجى إلغاء تحسين البطارية لهذا التطبيق من الإعدادات لضمان عمل التذكير."
                    android:textSize="11sp" android:textColor="#66000000"
                    android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:text="تم التطوير لوجه الله - لا تنسونا من صالح دعائكم"
                android:textSize="11sp" android:textColor="#66FFFFFF" android:gravity="center"
                android:layout_marginTop="24dp" android:layout_marginBottom="24dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>